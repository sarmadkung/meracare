# MeraCare Go API — copy to apps/api/.env and fill in.
# Never commit real values. See docs/09-security-privacy.md.

# --- Server ---
PORT=8080
ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Comma-separated origins allowed to call the API from a browser (future web app).
CORS_ALLOWED_ORIGINS=

# --- Database ---
# Local development (see docker-compose.yml):
DATABASE_URL=postgres://meracare:meracare@localhost:55432/meracare?sslmode=disable
# Supabase (Session pooler connection string — not the transaction pooler on
# 6543, whose lack of prepared-statement support breaks pgx):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_MAX_CONNS=10

# Integration tests. Unset, they are skipped; set, they run against this
# database and TRUNCATE every application table on every test. It must
# therefore be a local database, and internal/testsupport refuses anything else
# before it connects. Nothing hosted, ever.
# TEST_DATABASE_URL=postgres://meracare:meracare@localhost:55432/meracare?sslmode=disable

# --- Supabase Auth ---
# Project URL, e.g. https://<project-ref>.supabase.co
# Required: it yields both the JWKS endpoint and the expected token issuer.
SUPABASE_URL=

# How access tokens are verified.
#
#   asymmetric   (default, recommended) Verify against the project's published
#                signing keys at <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
#                The API holds only public keys, so it can verify a token but
#                can never mint one. Leave SUPABASE_JWT_SECRET empty.
#
#   legacy_hs256 Verify with the project's shared JWT secret. The same secret
#                both verifies and signs, so anything holding it can forge a
#                token for any user. Only for projects still on the legacy
#                secret; migrate to asymmetric keys when you can.
SUPABASE_JWT_MODE=asymmetric

# Only for SUPABASE_JWT_MODE=legacy_hs256. Startup fails if this is set while
# the mode is asymmetric, so an unused forgeable key cannot linger unnoticed.
SUPABASE_JWT_SECRET=

# Expected `aud` claim on Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated
# Allowed clock skew when validating exp/nbf/iat.
SUPABASE_JWT_LEEWAY=30s

# --- Notifications and push (Phase 11) ---
#
# The scheduler is the one background process the API runs. It decides which
# notifications should exist, delivers the ones that are due, and forgets the
# ones that are old. It is on by default because the notification inbox depends
# on it: with no pass, nothing is ever created and the inbox stays empty.
#
# Turn it off only on an instance that must not do background work — a
# migration runner, or a second API instance you are deliberately keeping to
# request handling. It is safe for several instances to run it: work is claimed
# in the database with FOR UPDATE SKIP LOCKED, so two schedulers take different
# rows rather than delivering the same notification twice.
NOTIFICATION_SCHEDULER_ENABLED=true

# How often a pass runs. Notifications are scheduled to the minute and each pass
# re-examines an overlapping window, so a late tick costs nothing.
NOTIFICATION_SCHEDULER_INTERVAL=1m

# How long a notification is kept before it is deleted. A notification is a copy
# of something the care record already holds — the dose, the task, the care
# event all remain — so keeping it forever grows a table without preserving
# anything (docs/20-notifications-delivery.md).
NOTIFICATION_RETENTION=720h

# Whether to actually push.
#
# Off by default, and that is the honest setting: MeraCare holds no push
# credentials, so there is nowhere to send a notification. With it off,
# notifications are still created and still appear in the app's inbox; they are
# simply marked "skipped" instead of being delivered to a phone, and the mobile
# app keeps scheduling its own local reminders. Turning it on without a
# configured Expo project would replace working local reminders with pushes
# that go nowhere.
#
# Before setting this to true, read docs/20-notifications-delivery.md: it needs
# an EAS project id in apps/mobile/app.json and push credentials in EAS.
PUSH_ENABLED=false

# Optional, and a secret. Only needed when the Expo project has enhanced push
# security enabled. Create it with `eas whoami` / the Expo dashboard and put it
# in the deployment's environment — never in this file and never in the
# repository (docs/09-security-privacy.md).
EXPO_ACCESS_TOKEN=
