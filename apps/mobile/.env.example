# MeraCare mobile app — copy to apps/mobile/.env and fill in.
#
# Only EXPO_PUBLIC_* variables reach the app, and they are inlined into the
# JavaScript bundle. Never put a secret here — in particular, never the
# Supabase service role key (docs/09-security-privacy.md).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Project Settings → API).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Go API base URL, without a trailing slash.
# iOS simulator can use localhost; a physical device needs the LAN address of
# your machine, and the Android emulator uses 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:8080

# --- Notifications ---
# Reminders for medication, tasks, and appointments are scheduled by the device
# itself and need no configuration at all: they work offline and without any
# push credentials.
#
# Remote push is not implemented yet. When it is, an Expo push token requires an
# EAS project id, which lives in app.json under `extra.eas.projectId` and is
# written there by `eas init` — it is not an environment variable and is not a
# secret. The credentials that are secret (an Apple push key, an FCM service
# account) belong in EAS, never in this file and never in the repository
# (docs/09-security-privacy.md).

# --- Google sign-in ---
# Nothing to add. "Continue with Google" needs only the Supabase URL and anon
# key above: Supabase holds the Google client secret and performs the OAuth
# exchange, so no Google credential belongs on the device. Enabling the provider
# is dashboard configuration — see docs/19-google-authentication.md.
