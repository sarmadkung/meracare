# Caddy terminates TLS for the GenxCare API and forwards to it on localhost.
#
# The certificate is obtained and renewed automatically once api.genxcare.app
# resolves to this droplet. Until the DNS record exists, Caddy retries in the
# background and the API is still reachable on the server itself.

api.genxcare.app {
	encode zstd gzip

	# The client's real address, for the API's request log.
	reverse_proxy 127.0.0.1:8090 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/api.genxcare.app.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
