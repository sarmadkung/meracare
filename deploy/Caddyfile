# Caddy terminates TLS for the GenxCare API and forwards to it on localhost.
#
# The certificate is obtained and renewed automatically once
# api.rest-api-mock.online resolves to this droplet. Until the DNS record
# exists, Caddy retries in the background and the API is still reachable on the
# server itself.

api.rest-api-mock.online {
	encode zstd gzip

	# The client's real address, for the API's request log.
	reverse_proxy 127.0.0.1:8090 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/api.rest-api-mock.online.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
